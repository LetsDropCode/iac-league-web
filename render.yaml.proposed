# PROPOSAL ONLY. Do not apply before live independent backup + restore drill,
# cost approval, and review of docs/STORAGE_RUNBOOK.md. Match existing service.
services:
  - type: web
    name: iac-league-web
    runtime: python
    region: oregon
    repo: https://github.com/LetsDropCode/iac-league-web
    branch: main
    plan: starter
    numInstances: 1
    autoDeployTrigger: "off"
    buildCommand: python -m pip install -r requirements.lock
    startCommand: python backup_runner.py
    disk:
      name: league-data
      mountPath: /var/data
      sizeGB: 1
    envVars:
      - key: LEAGUE_DEPLOYMENT_STAGE
        value: production
      - key: WEB_CONCURRENCY
        value: "2"
      - key: LEAGUE_MONITOR_SERVICE
        value: iac-league-production
      - key: LEAGUE_ENV
        value: production
      - key: LEAGUE_DATA_DIR
        value: /var/data/league
      - key: LEAGUE_DISK_MOUNT
        value: /var/data
      - key: LEAGUE_VOLUME_ID
        sync: false
      - key: LEAGUE_BACKUP_BUCKET
        sync: false
      - key: LEAGUE_BACKUP_PREFIX
        value: iac-league/
      - key: LEAGUE_BACKUP_INTERVAL_SECONDS
        value: 3600
      - key: LEAGUE_BACKUP_RETAIN
        value: 168
      - key: AWS_ACCESS_KEY_ID
        sync: false
      - key: AWS_SECRET_ACCESS_KEY
        sync: false
      - key: AWS_DEFAULT_REGION
        sync: false
      - key: SECRET_KEY
        sync: false
      - key: ADMIN_PASSWORD
        sync: false
