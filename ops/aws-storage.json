{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAC League independent backups and missing/failure monitoring",
  "Parameters": {
    "Service": {
      "Type": "String",
      "AllowedValues": ["iac-league-production", "iac-league-staging"]
    },
    "OperatorEmail": {
      "Type": "String",
      "Description": "Approved operator; must confirm SNS subscription and test receipt"
    }
  },
  "Resources": {
    "Backups": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "VersioningConfiguration": {"Status": "Enabled"},
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {"ServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "RecoverNoncurrentVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {"NoncurrentDays": 30},
              "AbortIncompleteMultipartUpload": {"DaysAfterInitiation": 1}
            }
          ]
        }
      }
    },
    "TLSOnly": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {"Ref": "Backups"},
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {"Fn::GetAtt": ["Backups", "Arn"]},
                {"Fn::Sub": "${Backups.Arn}/*"}
              ],
              "Condition": {"Bool": {"aws:SecureTransport": "false"}}
            }
          ]
        }
      }
    },
    "Alerts": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "Subscription": [
          {"Protocol": "email", "Endpoint": {"Ref": "OperatorEmail"}}
        ]
      }
    },
    "AlertPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [{"Ref": "Alerts"}],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {"Service": "cloudwatch.amazonaws.com"},
              "Action": "sns:Publish",
              "Resource": {"Ref": "Alerts"},
              "Condition": {
                "StringEquals": {"aws:SourceAccount": {"Ref": "AWS::AccountId"}},
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudwatch:${AWS::Region}:${AWS::AccountId}:alarm:*"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "BackupAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {"Fn::Sub": "${Service}-backup-unhealthy-or-missing"},
        "AlarmDescription": "Backup failed, exceeded 2-hour age, or monitoring/service stopped. Investigate; never auto-restart or delete data.",
        "Namespace": "IACLeague/Storage",
        "MetricName": "BackupHealthy",
        "Dimensions": [{"Name": "Service", "Value": {"Ref": "Service"}}],
        "Statistic": "Minimum",
        "Period": 60,
        "EvaluationPeriods": 3,
        "DatapointsToAlarm": 3,
        "Threshold": 1,
        "ComparisonOperator": "LessThanThreshold",
        "TreatMissingData": "breaching",
        "AlarmActions": [{"Ref": "Alerts"}],
        "OKActions": [{"Ref": "Alerts"}]
      }
    },
    "RuntimePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Attach only to approved runtime principal; no keys generated by this stack",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "s3:ListBucket",
              "Resource": {"Fn::GetAtt": ["Backups", "Arn"]},
              "Condition": {"StringLike": {"s3:prefix": ["iac-league/*"]}}
            },
            {
              "Effect": "Allow",
              "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
              "Resource": {"Fn::Sub": "${Backups.Arn}/iac-league/*"}
            },
            {
              "Effect": "Allow",
              "Action": "cloudwatch:PutMetricData",
              "Resource": "*",
              "Condition": {"StringEquals": {"cloudwatch:namespace": "IACLeague/Storage"}}
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "Bucket": {"Value": {"Ref": "Backups"}},
    "RuntimePolicyArn": {"Value": {"Ref": "RuntimePolicy"}},
    "AlarmName": {"Value": {"Ref": "BackupAlarm"}}
  }
}
